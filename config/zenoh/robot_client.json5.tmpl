////
//// Robot Zenoh client + ros2dds bridge (any fleet robot).
//// Placeholders: __ROBOT__, __DOMAIN__, __CENTRAL_HOST__
////
//// Robot->central sensor topics: publishers ONLY. The map goes out only as
//// the zlib copy map_wire_z; the central PC rebuilds /__ROBOT__/map from it.
//// TF is /tf_zenoh (best-effort relay), never /tf — a reliable
//// Zenoh subscription on /tf stalls slam_toolbox and freezes map→odom.
//// Do NOT put map/tf under subscribers — that reinjects TF.
//// Actions stay bidirectional. Keep this list in step with
//// config/zenoh/central_router.json5.tmpl in the central-computer workspace.
////
{
  mode: "client",
  connect: {
    endpoints: ["tcp/__CENTRAL_HOST__:7447"],
  },
  scouting: {
    multicast: { enabled: false },
  },
  plugins: {
    ros2dds: {
      domain: __DOMAIN__,
      // false: do not override CYCLONEDDS_URI. Robot DDS is loopback-only
      // via config/cyclonedds/robot_localhost.xml.
      ros_localhost_only: false,
      nodename: "zenoh_bridge___ROBOT__",
      // false: if Zenoh falls behind, drop samples instead of blocking the
      // ROS publisher. Blocking stalls slam_toolbox /tf (map->odom goes stale
      // and Nav2 reports a false goal success).
      reliable_routes_blocking: false,
      allow: {
        publishers: [
          "/__ROBOT__/map_wire_z",
          "/__ROBOT__/tf_zenoh",
          "/__ROBOT__/tf_static_zenoh",
          "/__ROBOT__/nav2_collision_ahead",
          "/__ROBOT__/nav2_retrace_active",
          // RViz on the central PC; sent only while someone subscribes there.
          "/__ROBOT__/plan",
          "/__ROBOT__/scan_normalized",
          "/__ROBOT__/local_costmap/costmap",
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        subscribers: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        service_servers: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        service_clients: [
          "/__ROBOT__/navigate_to_pose/_action/.*",
          "/__ROBOT__/compute_path_to_pose/_action/.*",
        ],
        action_servers: [
          "/__ROBOT__/navigate_to_pose",
          "/__ROBOT__/compute_path_to_pose",
        ],
        action_clients: [
          "/__ROBOT__/navigate_to_pose",
          "/__ROBOT__/compute_path_to_pose",
        ],
      },
      pub_max_frequencies: [
        "/__ROBOT__/map_wire_z=1",
        "/__ROBOT__/tf_zenoh=10",
        "/__ROBOT__/tf_static_zenoh=1",
        "/__ROBOT__/plan=2",
        "/__ROBOT__/scan_normalized=2",
        "/__ROBOT__/local_costmap/costmap=1",
      ],
    },
  },
}
