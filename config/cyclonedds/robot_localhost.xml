<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Robot DDS stays on the loopback interface.

  Zenoh carries traffic to the central PC. If Cyclone also joins Wi-Fi, it
  remembers those peers and, once the robot drives out of range, every node
  logs "ddsi_udp_conn_write ... failed with retcode -1".

  MaxAutoParticipantIndex is raised because a loopback-only domain discovers
  with participant indices. The default cap is too small for Nav2 plus SLAM.

  SocketReceiveBufferSize asks for up to 8 MB per socket. The kernel grants
  at most net.core.rmem_max (Ubuntu default 208 KB), so raise that too; see
  the README. With the camera streams on loopback and the CPU busy, 208 KB
  buffers overflowed (netstat -su "receive buffer errors"), and the Zenoh
  bridge lost discovery of tf_zenoh_publish: the central explorer never got
  the robot's pose and sent no goals.

  Leave MaxMessageSize / FragmentSize at their defaults. 64 KB fragments cut
  the camera streams' DDS cost by ~15%, but the Zenoh bridge (its own Cyclone
  build) then never answered compute_path_to_pose requests from the central
  PC, so the explorer could not send goals.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" priority="default" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize max="8MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
