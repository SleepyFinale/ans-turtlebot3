[Unit]
Description=Boot WiFi Connection (Lab/SNS first, then RPi/RaspAP, then Azure fallback)
After=network-pre.target
Wants=network-pre.target
Before=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/turtlebot3_ws/scripts/boot_wifi.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target