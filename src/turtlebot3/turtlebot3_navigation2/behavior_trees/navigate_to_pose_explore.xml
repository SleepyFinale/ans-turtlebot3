<!--
  NavigateToPose for frontier exploration (the robot's default tree).

  Nav2's navigate_to_pose_w_replanning_and_recovery.xml with four changes:

  - The path is kept while it stays valid (IsPathValid: nothing lethal or
    inscribed on it in the global costmap) and the goal is unchanged, and
    replanned only otherwise. Replanning from scratch every second, the
    planner flipped between near-equal routes (left or right of an obstacle)
    as the robot turned, so it turned toward one, then the other, and stayed
    where it was. A new obstacle on the path, including a low obstacle the
    memory confirms, still forces a replan.
  - Costmap clears keep the 1 m square around the robot
    (ClearCostmapExceptRegion, reset_distance 1.0). In Humble every
    obstacle-type layer is clearable, including the stereo layer and the
    low-obstacle memory, so a full clear also erased a low object the robot
    had just driven up to. Closer than 0.35 m stereo cannot see it again, so
    the controller drove straight back into it: hit, back off, hit again.
    Marks next to the robot are collision_resolver's to clear; it checks
    them against the sensors first.
  - No 5 s Wait in the recovery round: a 1 s pause is enough for a person to
    step aside, and the explorer is waiting on this goal.
  - Four retries instead of six, so a goal that cannot be reached goes back
    to the explorer sooner.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <Fallback name="KeepValidPath">
            <ReactiveSequence>
              <Inverter>
                <GlobalUpdatedGoal/>
              </Inverter>
              <IsPathValid path="{path}"/>
            </ReactiveSequence>
            <RecoveryNode number_of_retries="1" name="ComputePathToPose">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context"
                service_name="global_costmap/clear_except_global_costmap" reset_distance="1.0"/>
            </RecoveryNode>
          </Fallback>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearCostmapExceptRegion name="ClearLocalCostmap-Context"
            service_name="local_costmap/clear_except_local_costmap" reset_distance="1.0"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearCostmapExceptRegion name="ClearLocalCostmap-Subtree"
              service_name="local_costmap/clear_except_local_costmap" reset_distance="1.0"/>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Subtree"
              service_name="global_costmap/clear_except_global_costmap" reset_distance="1.0"/>
          </Sequence>
          <BackUp backup_dist="0.15" backup_speed="0.08"/>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="1"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
