<!--
  Navigate-to-pose tree with replanning and recoveries.
  Keeps short in-tree recoveries (backup/spin/wait) while nav2_retrace_escape.py
  performs memory-based retreat when lethal-space or stall triggers fire.

  Low-obstacle note: ultrasonic blob marks are non-clearing. Prefer clearing the
  local costmap first so transient planner/controller issues recover without
  wiping global evidence of low obstacles (global also subscribes to blob scans
  when enabled in launch). Full global clear remains as a secondary recovery.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="3" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <Sequence name="EscapeLethalThenRetryPlan">
              <!-- Keep the first response local and cheap before escalating to
                   a full global clear or a robot-side retrace intervention. -->
              <!-- Let nav2_retrace_escape observe planner failure before fallback chain. -->
              <Wait wait_duration="0.4"/>
              <ClearEntireCostmap
                name="ClearLocalCostmap-PreEscape"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="0.2"/>
              <BackUp backup_dist="0.25" backup_speed="0.06"/>
              <Spin spin_dist="0.6"/>
              <Wait wait_duration="0.3"/>
              <ClearEntireCostmap
                name="ClearLocalCostmap-PlanRetry"
                service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap
                name="ClearGlobalCostmap-Context"
                service_name="global_costmap/clear_entirely_global_costmap"/>
              <Wait wait_duration="0.8"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="2" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="ClearLocalThenRetryControl">
            <!-- Control failures are often transient local-costmap issues, so
                 retry with a small backup and local clear before broader reset. -->
            <!-- brief delay gives retrace node time to cancel and run reverse leg -->
            <Wait wait_duration="0.3"/>
            <BackUp backup_dist="0.15" backup_speed="0.05"/>
            <ClearEntireCostmap
              name="ClearLocalCostmap-Context"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait wait_duration="0.4"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <!-- Round-robin avoids getting stuck on one recovery behavior forever;
               each failure cycles to the next broader fallback. -->
          <ClearEntireCostmap
            name="ClearLocalCostmap-Subtree"
            service_name="local_costmap/clear_entirely_local_costmap"/>
          <Sequence name="ClearBothCostmaps">
            <ClearEntireCostmap
              name="ClearLocalCostmap-Subtree-Full"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap-Subtree"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <BackUp backup_dist="0.15" backup_speed="0.05"/>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5.0"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
